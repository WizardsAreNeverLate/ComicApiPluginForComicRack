<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>ComicApiPlugin.Plugin</RootNamespace>
		<UsesComicRack>true</UsesComicRack>
		<ComicRackPluginDir Condition="'$(ComicRackPluginDir)' == ''">$(COMICRACK_PLUGIN_DIR)</ComicRackPluginDir>
	</PropertyGroup>
	<!-- The in-app smoke test's recorded-response switch (Smoke/RecordedResponses.cs). Never set for a build you ship. -->
	<PropertyGroup Condition="'$(CvsRecordedResponses)' == 'true'">
		<DefineConstants>$(DefineConstants);CVS_RECORDED_RESPONSES</DefineConstants>
		<!-- Its own output and intermediate folders, so this build can never overwrite the shipping bin\<Configuration>\net48\ComicApiPlugin.crplugin. -->
		<BaseOutputPath>bin\smoke\</BaseOutputPath>
		<IntermediateOutputPath>obj\smoke\$(Configuration)\</IntermediateOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Smoke\**" />
	</ItemGroup>
	<ItemGroup Condition="'$(CvsRecordedResponses)' == 'true'">
		<Compile Include="Smoke\**\*.cs" />
		<Compile Include="..\..\tests\Shared\ComicVineFixtures.cs" Link="Smoke\ComicVineFixtures.cs" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="System.Drawing" />
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="ComicRack.Plugins" HintPath="$(ComicRackPath)ComicRack.Plugins.dll" Private="false" />
		<Reference Include="ComicRack.Engine" HintPath="$(ComicRackPath)ComicRack.Engine.dll" Private="false" />
		<Reference Include="cYo.Common" HintPath="$(ComicRackPath)cYo.Common.dll" Private="false" />
		<Reference Include="cYo.Common.Windows" HintPath="$(ComicRackPath)cYo.Common.Windows.dll" Private="false" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ComicApiPlugin.Core\ComicApiPlugin.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="ComicApiPlugin.Tests" />
		<InternalsVisibleTo Include="ComicApiPlugin.Oracle.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Package\**\*" />
		<EmbeddedResource Include="Package\Images\comicvinelogo.png;Package\Images\*arrow.png" LogicalName="%(Filename)%(Extension)" />
	</ItemGroup>
	<Target Name="PackCrPlugin" AfterTargets="Build">
		<PropertyGroup>
			<CrPluginStaging>$(IntermediateOutputPath)crplugin\</CrPluginStaging>
			<CrPluginPath>$(OutDir)ComicApiPlugin.crplugin</CrPluginPath>
		</PropertyGroup>
		<ItemGroup>
			<CrPluginContent Include="$(TargetPath);$(OutDir)ComicApiPlugin.Core.dll;Package\Package.ini;Package\Images\*;Package\Languages\*.zip" />
		</ItemGroup>
		<RemoveDir Directories="$(CrPluginStaging)" />
		<Copy SourceFiles="@(CrPluginContent)" DestinationFolder="$(CrPluginStaging)" />
		<ZipDirectory SourceDirectory="$(CrPluginStaging)" DestinationFile="$(CrPluginPath)" Overwrite="true" />
		<Message Importance="high" Text="$(MSBuildProjectName) -> $([System.IO.Path]::GetFullPath('$(CrPluginPath)'))" />
	</Target>
	<!--
		Set COMICRACK_PLUGIN_DIR (or -p:ComicRackPluginDir=) to an installed copy of this plugin, such as
		%APPDATA%\cYo\ComicRack Community Edition\Scripts\Comic API Plugin, and every build unpacks the .crplugin there:
		the DLLs, Package.ini, the images and the language zips, as ComicRack installs them. The PDBs go too, for line
		numbers in stack traces. Close ComicRack first, because it locks the DLLs. The recorded-response build never deploys.
	-->
	<Target Name="DeployCrPlugin" AfterTargets="PackCrPlugin" Condition="'$(ComicRackPluginDir)' != '' and '$(CvsRecordedResponses)' != 'true'">
		<Unzip SourceFiles="$(OutDir)ComicApiPlugin.crplugin" DestinationFolder="$(ComicRackPluginDir)" OverwriteReadOnlyFiles="true" />
		<Copy SourceFiles="$(OutDir)ComicApiPlugin.pdb;$(OutDir)ComicApiPlugin.Core.pdb" DestinationFolder="$(ComicRackPluginDir)" />
		<Message Importance="high" Text="$(MSBuildProjectName) deployed to $(ComicRackPluginDir)" />
	</Target>
</Project>
