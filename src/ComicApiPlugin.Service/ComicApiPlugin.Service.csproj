<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net11.0-windows</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>ComicApiPlugin.Service</RootNamespace>
		<!-- Framework-dependent: the user installs the ASP.NET Core 11 runtime, and the apphost exe finds it without dotnet on PATH. -->
		<SelfContained>false</SelfContained>
		<!-- No IIS, so no web.config in the publish folder. -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>
	<!--
		The native OpenCV library, 64-bit, beside the exe, where OpenCvSharp.dll finds it by name. Only this file is taken from the package:
		it also holds opencv_videoio_ffmpeg (28 MB, video decoding), which is not needed to read covers.
	-->
	<ItemGroup>
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" ExcludeAssets="all" GeneratePathProperty="true" />
		<None Include="$(PkgOpenCvSharp4_runtime_win)\runtimes\win-x64\native\OpenCvSharpExtern.dll" Link="OpenCvSharpExtern.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ComicApiPlugin.Core\ComicApiPlugin.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="ComicApiPlugin.Service.Tests" />
	</ItemGroup>
</Project>