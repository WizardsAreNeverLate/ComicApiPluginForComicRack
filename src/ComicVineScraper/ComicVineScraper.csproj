<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>ComicVineScraper.Plugin</RootNamespace>
		<UsesComicRack>true</UsesComicRack>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="System.Drawing" />
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="ComicRack.Plugins" HintPath="$(ComicRackPath)ComicRack.Plugins.dll" Private="false" />
		<Reference Include="ComicRack.Engine" HintPath="$(ComicRackPath)ComicRack.Engine.dll" Private="false" />
		<Reference Include="cYo.Common" HintPath="$(ComicRackPath)cYo.Common.dll" Private="false" />
		<Reference Include="cYo.Common.Windows" HintPath="$(ComicRackPath)cYo.Common.Windows.dll" Private="false" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ComicVineScraper.Core\ComicVineScraper.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="ComicVineScraper.Tests" />
		<InternalsVisibleTo Include="ComicVineScraper.Oracle.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Package\**\*" />
	</ItemGroup>
	<Target Name="PackCrPlugin" AfterTargets="Build">
		<PropertyGroup>
			<CrPluginStaging>$(IntermediateOutputPath)crplugin\</CrPluginStaging>
			<CrPluginPath>$(OutDir)ComicVineScraper.crplugin</CrPluginPath>
		</PropertyGroup>
		<ItemGroup>
			<CrPluginContent Include="$(TargetPath);$(OutDir)ComicVineScraper.Core.dll;Package\Package.ini;Package\Images\*;Package\Languages\*.zip" />
		</ItemGroup>
		<RemoveDir Directories="$(CrPluginStaging)" />
		<Copy SourceFiles="@(CrPluginContent)" DestinationFolder="$(CrPluginStaging)" />
		<ZipDirectory SourceDirectory="$(CrPluginStaging)" DestinationFile="$(CrPluginPath)" Overwrite="true" />
		<Message Importance="high" Text="$(MSBuildProjectName) -> $([System.IO.Path]::GetFullPath('$(CrPluginPath)'))" />
	</Target>
</Project>
